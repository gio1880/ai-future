# ============================================
# AI Future Platform – Environment Variables
# Set these in your Render dashboard (not here)
# ============================================

# Server
NODE_ENV=production
PORT=10000

# Session (use a long random string in production)
SESSION_SECRET=change-this-to-a-long-random-string

# Persistent data directory (Render Disk mount path)
# Create a Render Disk mounted at /var/data and set this:
DATA_DIR=/var/data

# AI Tutor (optional). If set, the lesson-page 🤖 tutor panel calls the
# Anthropic API for Socratic hints. If unset, the tutor still works but
# returns built-in diagnostic hints instead. Never commit real keys.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_TUTOR_MODEL=claude-haiku-4-5-20251001

# ============================================
# Payments — Summer Camp + Code Lab membership
# See PAYMENTS.md for step-by-step setup.
# ============================================

# Stripe (required). Create at https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_, whsec_...) in staging and live keys (sk_live_) in production.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Stripe publishable key — only needed if you ever embed Stripe.js on the page.
# The default Register & Pay button uses server-created Checkout Sessions, so
# this is optional.
# STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Optional: use Stripe Price IDs for Code Lab memberships to bill recurring
# subscriptions. If unset, the server creates one-time payments at the prices
# defined in payments.js. Create Prices in Stripe Dashboard → Products.
# STRIPE_CODELAB_MONTHLY_PRICE_ID=price_...
# STRIPE_CODELAB_ANNUAL_PRICE_ID=price_...

# Public URL of the deployed site (used for Stripe success/cancel redirects).
# In local dev you can leave it unset — the server falls back to the request host.
# SITE_BASE_URL=https://aifuture.com

# Resend email (required for confirmation emails).
# Sign up at https://resend.com, verify a sending domain, create an API key.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=AI Future <no-reply@aifuture.com>

# Google Sheets (optional — used to mirror registrations into a spreadsheet).
# 1) Create a Google Cloud project, enable the Sheets API.
# 2) Create a Service Account, create a JSON key, share your sheet with the
#    service account's email (Editor).
# 3) Paste the full JSON below (single-line) and set the sheet ID.
# GOOGLE_SHEETS_ID=1AbC...xyz
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Optional override — defaults to "Registrations!A:K"
# GOOGLE_SHEETS_RANGE=Registrations!A:K

# Payments admin panel (Basic Auth at /payments-admin).
PAYMENTS_ADMIN_USER=admin
PAYMENTS_ADMIN_PASSWORD=change-me
