# ============================================
# AI Future Platform – Environment Variables
# Set these in your Render dashboard, not here
# ============================================

# Server environment
NODE_ENV=production

# Port (Render sets this automatically — do not set manually)
# PORT=10000

# Session secret — use a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Persistent data directory (Render Disk mount path)
# In Render: create a Disk mounted at /var/data and set this var
DATA_DIR=/var/data
